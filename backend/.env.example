# Groq API key. Used only for prose answers (Phase 5+). Never commit a real key.
LLM_API_KEY=
# Groq's OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq model id for prose answers.
# openai/gpt-oss-120b base limits: 30 requests/minute, 1,000/day, 8,000 tokens/minute, 200,000 tokens/day.
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
# After ingest, point at the generated facts so prose answers can retrieve passages.
# Paths may be absolute or relative to the backend/ directory.
# Example after `python scripts/ingest.py --source fixture` or `--source live`:
FACTS_PATH=data/scheme_facts.json
# Persistent Chroma directory written by ingest. Prose questions call Groq only when this index is non-empty.
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Comma-separated browser origins allowed by CORS. Unset keeps localhost Vite defaults.
# Same-origin Railway (API + UI on one domain) does not need this.
# Split frontend service: CORS_ORIGINS=https://web-production-xxxx.up.railway.app
CORS_ORIGINS=
# Built Vite app directory served by FastAPI in the single-service Docker image.
# FRONTEND_DIST=/app/frontend_dist

